# CRM client (Vite) — copy to .env and fill in values. Never commit real secrets.

VITE_USE_MOCKS=false
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Vercel / server (Google OAuth callback at /api/auth/google/callback)
APP_URL=https://casefunders-crm-d.vercel.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Prefer Supabase (Vercel cannot run this app's Cloudflare Worker build for /api/* routes)
GOOGLE_REDIRECT_URI=https://qagxnrwvueqwjuijbgzg.supabase.co/functions/v1/google-calendar-callback
GOOGLE_OAUTH_STATE_SECRET=generate_a_random_32_char_string

# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# Same GOOGLE_* and APP_URL as above, plus:
#
# SendGrid (matches casefunders_platform — API, not SMTP)
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM_EMAIL=support@casefunders.com
# SENDGRID_FROM_NAME=CaseFunders
# DEVELOPER_EMAIL=developer.gaurav074@gmail.com
# LEAD_NOTIFY_EMAILS=nick@casefunders.com

# Optional: Database Webhook on public.leads INSERT → send-lead-email function
# (notifies team when leads are created inside CRM, not only from the website)

# LinkedIn Ads Lead Gen (CaseFunders Campaign Manager account 539500171)
# Edge Function: ingest-linkedin-lead  (verify_jwt = false)
# Webhook URL (include the anon key so LinkedIn can POST without JWT headers):
# https://qagxnrwvueqwjuijbgzg.supabase.co/functions/v1/ingest-linkedin-lead?apikey=<SUPABASE_ANON_KEY>
#
# LINKEDIN_AD_ACCOUNT_ID=539500171
# LINKEDIN_CLIENT_SECRET=<LinkedIn developer app client secret — required for GET challenge>
# LINKEDIN_ACCESS_TOKEN=<token with r_ads_leadgen_automation — required to fetch native LEAD_ACTION payloads>
# LINKEDIN_WEBHOOK_SECRET=<optional shared secret for Zapier/mapped POSTs, as ?token= or x-webhook-secret>
# LINKEDIN_API_VERSION=202508

# CaseFunders live website — CRM Applications page (Open links)
VITE_CASEFUNDERS_PLATFORM_URL=https://www.casefunders.com

# Supabase Edge Function secrets (list-platform-applications):
# CASEFUNDERS_PLATFORM_API_URL=https://www.casefunders.com
# CASEFUNDERS_CRM_API_TOKEN=<same as CRM_API_TOKEN in Django .env>
